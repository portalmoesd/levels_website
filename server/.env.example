# Copy to .env for local development. On Render these are set in the
# dashboard under Environment; never commit real values.

# --- required -------------------------------------------------------------
# Provided automatically by Render when you attach a Postgres instance.
DATABASE_URL=postgresql://levels@localhost:5432/levels

# Staff access code for issuing certificates. Any long random string; the same
# value is typed into the certificate-maker app.
CERT_ACCESS_CODE=change-me-to-something-long-and-random

# Salt for hashing visitor IPs, so raw addresses are never stored.
IP_HASH_SALT=change-me-too

# --- Meta Conversions API -------------------------------------------------
# From Events Manager. The pixel ID is public; the token is a secret.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Set while testing so events appear under Test Events instead of live data.
# Remove once verified.
META_TEST_EVENT_CODE=

# --- email notifications --------------------------------------------------
# With these unset, submissions are still stored — they are just not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Levels Academy <info@levels.ge>
NOTIFY_EMAIL=info@levels.ge

# --- optional -------------------------------------------------------------
# Extra origins allowed to call this API, comma separated.
EXTRA_ORIGINS=
