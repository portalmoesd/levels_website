---
/**
 * Detail pages at the site root: every English course, every art course and
 * every summer school destination.
 *
 * They live at the root (/ielts, /drawing-kids, /summer-school-california)
 * rather than under a folder, because that is where the Wix site put them and
 * where Google has them indexed. Moving them would throw away the existing
 * rankings for the sake of tidier URLs.
 *
 * The Georgian equivalents are generated by src/pages/ka/[slug].astro.
 */
import CoursePage from '../components/pages/CoursePage.astro';
import SummerSchoolPage from '../components/pages/SummerSchoolPage.astro';
import { detailRoutes } from '../data/routes';

export function getStaticPaths() {
  return detailRoutes.map((route) => ({
    params: { slug: route.slug },
    props: route,
  }));
}

const route = Astro.props;
---

{
  route.kind === 'summer' ? (
    <SummerSchoolPage school={route.school} locale="en" />
  ) : (
    <CoursePage course={route.course} locale="en" parent={route.parent} />
  )
}
