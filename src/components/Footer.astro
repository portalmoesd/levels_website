---
import { site, social } from '../data/site';
import { useTranslations, localePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const sections = [
  { key: 'nav.english', slug: 'english' },
  { key: 'nav.art', slug: 'art' },
  { key: 'nav.summer', slug: 'summer-schools' },
  { key: 'nav.studyAbroad', slug: 'study-abroad' },
] as const;

/* Only profiles that have actually been configured. The Facebook, Instagram
   and LinkedIn URLs load from Wix's API at runtime on the current site, so
   they could not be recovered from the crawl — see docs/wix-decommission.md. */
const socialLinks = (
  [
    ['Facebook', social.facebook],
    ['Instagram', social.instagram],
    ['Whatsapp', social.whatsapp],
    ['LinkedIn', social.linkedin],
  ] as const
).filter(([, url]) => Boolean(url));
---

<footer class="site-footer">
  <div class="container">
    <p class="site-footer__brand">levels academy</p>

    <div class="site-footer__cols">
      <nav aria-label={locale === 'ka' ? 'განყოფილებები' : 'Sections'}>
        <ul>
          {sections.map((item) => (
            <li><a href={localePath(item.slug, locale)}>{t(item.key)}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={locale === 'ka' ? 'აკადემია' : 'Academy'}>
        <ul>
          <li><a href={localePath('about', locale)}>{t('nav.about')}</a></li>
          <li><a href={localePath('team', locale)}>{t('nav.team')}</a></li>
          <li><a href={localePath('contact', locale)}>{t('nav.contact')}</a></li>
          <li><a href={localePath('work-with-us', locale)}>{t('footer.workWithUs')}</a></li>
          <li><a href={localePath('verify', locale)}>{t('verify.title')}</a></li>
        </ul>
      </nav>

      {socialLinks.length > 0 && (
        <nav aria-label="Social">
          <ul>
            {socialLinks.map(([name, url]) => (
              <li><a href={url} rel="noopener noreferrer me" target="_blank">{name}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="site-footer__contact">
        <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p class="site-footer__legal">
          © {year} by {site.name}.
        </p>
        <a href={localePath('privacy-policy', locale)}>{t('footer.privacy')}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-y);
    padding-block: var(--section-y);
    border-block-start: 1px solid var(--line);
    background: var(--surface);
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--navy);
    margin-block-end: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .site-footer__cols {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .site-footer a {
    font-size: var(--step--1);
    color: var(--ink);
    text-decoration: none;
  }
  .site-footer a:hover { color: var(--blue); text-decoration: underline; }

  .site-footer__contact {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .site-footer__legal {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-block-start: 0.4rem;
  }
</style>
