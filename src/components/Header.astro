---
import { site } from '../data/site';
import { useTranslations, localePath, otherLocale, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Current page slug, so the language switch stays on the same page. */
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);

const nav = [
  { key: 'nav.english', slug: 'english' },
  { key: 'nav.art', slug: 'art' },
  { key: 'nav.summer', slug: 'summer-schools' },
  { key: 'nav.studyAbroad', slug: 'study-abroad' },
  { key: 'nav.about', slug: 'about' },
  { key: 'nav.contact', slug: 'contact' },
] as const;

const here = localePath(slug, locale);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={localePath('', locale)}>
      <span class="brand__mark" aria-hidden="true">L</span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          nav.map((item) => {
            const href = localePath(item.slug, locale);
            const current = here === href;
            return (
              <li>
                <a href={href} aria-current={current ? 'page' : undefined}>
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
      <a class="btn btn--primary btn--sm" href={localePath('placement-quiz', locale)}>
        {t('nav.quiz')}
      </a>
      <a
        class="lang-switch"
        href={localePath(slug, other)}
        hreflang={other === 'ka' ? 'ka-GE' : 'en'}
        lang={other === 'ka' ? 'ka-GE' : 'en'}
      >
        {other === 'ka' ? 'ქარ' : 'EN'}
      </a>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t('nav.menu')}
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={localePath(item.slug, locale)}>{t(item.key)}</a></li>
      ))}
      <li><a href={localePath('placement-quiz', locale)}>{t('nav.quiz')}</a></li>
      <li><a href={localePath(slug, other)} lang={other === 'ka' ? 'ka-GE' : 'en'}>
        {other === 'ka' ? 'ქართული' : 'English'}
      </a></li>
      <li><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--navy);
    color: var(--gold);
    font-weight: 800;
  }
  .brand__name { font-size: var(--step-0); white-space: nowrap; }

  .site-nav { margin-inline-end: auto; }
  .site-nav__list {
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.75rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-nav a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--step--1);
    white-space: nowrap;
    padding-block: 0.5rem;
    border-block-end: 2px solid transparent;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--navy);
    border-block-end-color: var(--gold);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .site-header__phone {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
  }
  .btn--sm { padding: 0.55em 1.1em; font-size: var(--step--1); }

  .lang-switch {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .lang-switch:hover { background: var(--surface-alt); }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .nav-toggle__bar,
  .nav-toggle__bar::before,
  .nav-toggle__bar::after {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: 1.25rem;
    height: 2px;
    background: var(--navy);
    content: '';
    transition: translate 0.2s ease, rotate 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle__bar { top: 50%; }
  .nav-toggle__bar::before { top: -6px; }
  .nav-toggle__bar::after { top: 6px; }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bar { background: transparent; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar::before { top: 0; rotate: 45deg; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar::after { top: 0; rotate: -45deg; }

  .mobile-nav {
    border-block-start: 1px solid var(--line);
    background: var(--surface);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1.25rem;
  }
  .mobile-nav a {
    display: block;
    padding: 0.85rem 0;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    border-block-end: 1px solid var(--line);
  }

  @media (max-width: 62rem) {
    .site-nav,
    .site-header__phone { display: none; }
    .nav-toggle { display: block; }
    .brand { margin-inline-end: auto; }
  }
</style>

<script>
  // Mobile navigation. Progressive enhancement: with JS off the panel simply
  // stays hidden and the nav is reachable from the footer.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  // Escape closes it, and focus goes back to the button.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    if (panel) panel.hidden = true;
    toggle.focus();
  });
</script>
