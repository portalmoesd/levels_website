---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Identifies the form in the submissions table and in the Meta Lead event. */
  formName: string;
  /** Adds a course select populated from this list. */
  courseOptions?: { value: string; label: string }[];
  /** Adds a CV upload, used by the careers form. */
  withResume?: boolean;
  /** Adds a date of birth field, used by the careers form. */
  withBirthday?: boolean;
  /** Adds a company field, used by the corporate form. */
  withCompany?: boolean;
  submitLabel?: string;
}

const {
  locale,
  formName,
  courseOptions,
  withResume = false,
  withBirthday = false,
  withCompany = false,
  submitLabel,
} = Astro.props;

const t = useTranslations(locale);
const id = (field: string) => `${formName}-${field}`;
---

<form class="enquiry" data-form-name={formName} novalidate>
  {/*
    Honeypot. Real people never fill this in because it is hidden; most bots
    fill every field they find, so a non-empty value means a bot. It is checked
    on the server too — this copy just avoids a pointless round trip.
  */}
  <div class="enquiry__trap" aria-hidden="true">
    <label for={id('website')}>Website</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="enquiry__row">
    <div class="field">
      <label for={id('firstName')}>{t('form.firstName')} <span aria-hidden="true">*</span></label>
      <input id={id('firstName')} name="firstName" type="text" required autocomplete="given-name" />
      <p class="field__error" data-error-for="firstName" hidden></p>
    </div>

    <div class="field">
      <label for={id('lastName')}>{t('form.lastName')} <span aria-hidden="true">*</span></label>
      <input id={id('lastName')} name="lastName" type="text" required autocomplete="family-name" />
      <p class="field__error" data-error-for="lastName" hidden></p>
    </div>
  </div>

  <div class="enquiry__row">
    <div class="field">
      <label for={id('email')}>{t('form.email')} <span aria-hidden="true">*</span></label>
      <input id={id('email')} name="email" type="email" required autocomplete="email" />
      <p class="field__error" data-error-for="email" hidden></p>
    </div>

    <div class="field">
      <label for={id('phone')}>{t('form.phone')} <span aria-hidden="true">*</span></label>
      <input id={id('phone')} name="phone" type="tel" required autocomplete="tel" />
      <p class="field__error" data-error-for="phone" hidden></p>
    </div>
  </div>

  {withCompany && (
    <div class="field">
      <label for={id('company')}>{locale === 'ka' ? 'კომპანია' : 'Company'}</label>
      <input id={id('company')} name="company" type="text" autocomplete="organization" />
    </div>
  )}

  {withBirthday && (
    <div class="field">
      <label for={id('birthday')}>{t('form.birthday')}</label>
      <input id={id('birthday')} name="birthday" type="date" autocomplete="bday" />
    </div>
  )}

  {courseOptions && courseOptions.length > 0 && (
    <div class="field">
      <label for={id('course')}>{t('form.course')}</label>
      <select id={id('course')} name="course">
        <option value="">{locale === 'ka' ? 'აირჩიე კურსი' : 'Choose a course'}</option>
        {courseOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </div>
  )}

  <div class="field">
    <label for={id('message')}>{t('form.message')}</label>
    <textarea id={id('message')} name="message" rows="4"></textarea>
  </div>

  {withResume && (
    <div class="field">
      <label for={id('resume')}>{t('form.resume')}</label>
      <input
        id={id('resume')}
        name="resume"
        type="file"
        accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      />
      <p class="field__hint muted">
        {locale === 'ka' ? 'PDF ან Word, მაქსიმუმ 5MB' : 'PDF or Word, up to 5MB'}
      </p>
      <p class="field__error" data-error-for="resume" hidden></p>
    </div>
  )}

  <button class="btn btn--primary" type="submit">{submitLabel ?? t('form.submit')}</button>

  {/*
    The status message is a live region so screen readers announce success or
    failure without the user having to hunt for it.
  */}
  <p class="enquiry__status" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .enquiry { display: grid; gap: 1.1rem; max-width: 40rem; }

  .enquiry__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .enquiry__row {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .field { display: grid; gap: 0.35rem; }
  .field label { font-weight: 600; font-size: var(--step--1); }
  .field span { color: var(--danger); }

  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.7em 0.85em;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    width: 100%;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--navy-300);
  }
  .field textarea { resize: vertical; }

  .field__hint { font-size: var(--step--1); }
  .field__error { color: var(--danger); font-size: var(--step--1); font-weight: 500; }
  .field [aria-invalid='true'] { border-color: var(--danger); }

  .enquiry__status {
    padding: 0.9rem 1.1rem;
    border-radius: 10px;
    font-weight: 500;
  }
  .enquiry__status[data-state='ok'] {
    background: rgb(30 125 68 / 10%);
    color: var(--success);
  }
  .enquiry__status[data-state='error'] {
    background: rgb(192 57 43 / 10%);
    color: var(--danger);
  }
</style>

<script>
  import { trackLead } from '../lib/analytics';

  const MAX_RESUME_BYTES = 5 * 1024 * 1024;

  // Messages are read off the page rather than hardcoded, so the form speaks
  // whichever language the page is in.
  const html = document.documentElement;
  const isKa = html.lang.startsWith('ka');
  const text = {
    required: isKa ? 'ველის შევსება სავალდებულოა' : 'This field is required',
    email: isKa ? 'შეიყვანე სწორი ელ. ფოსტა' : 'Enter a valid email address',
    phone: isKa ? 'შეიყვანე სწორი ტელეფონის ნომერი' : 'Enter a valid phone number',
    tooBig: isKa ? 'ფაილი 5MB-ზე დიდია' : 'That file is larger than 5MB',
    sending: isKa ? 'იგზავნება…' : 'Sending…',
    ok: isKa
      ? 'გმადლობთ — თქვენი შეტყობინება მიღებულია და მალე დაგიკავშირდებით.'
      : 'Thank you — we have received your message and will be in touch shortly.',
    error: isKa
      ? 'დაფიქსირდა შეცდომა. სცადე ხელახლა ან დაგვირეკე: 032 2 18 06 05.'
      : 'Something went wrong. Please try again, or call us on 032 2 18 06 05.',
  };

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const PHONE = /^[+\d][\d\s()-]{5,}$/;

  function setError(form: HTMLFormElement, name: string, message: string | null) {
    const field = form.querySelector<HTMLElement>(`[name="${name}"]`);
    const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (field) field.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (!slot) return;
    slot.textContent = message ?? '';
    slot.hidden = !message;
  }

  function validate(form: HTMLFormElement): boolean {
    let ok = true;
    const fail = (name: string, message: string) => {
      setError(form, name, message);
      ok = false;
    };

    for (const name of ['firstName', 'lastName', 'email', 'phone']) {
      const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (!input) continue;
      setError(form, name, null);
      if (!input.value.trim()) {
        fail(name, text.required);
      } else if (name === 'email' && !EMAIL.test(input.value.trim())) {
        fail(name, text.email);
      } else if (name === 'phone' && !PHONE.test(input.value.trim())) {
        fail(name, text.phone);
      }
    }

    const resume = form.querySelector<HTMLInputElement>('[name="resume"]');
    setError(form, 'resume', null);
    if (resume?.files?.[0] && resume.files[0].size > MAX_RESUME_BYTES) {
      fail('resume', text.tooBig);
    }

    // Move focus to the first problem so keyboard and screen reader users are
    // taken straight to it.
    if (!ok) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    }
    return ok;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form.enquiry')) {
    const status = form.querySelector<HTMLElement>('.enquiry__status');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formName = form.dataset.formName ?? 'enquiry';
    const originalLabel = submit?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate(form)) return;

      const apiBase = window.__API_BASE;
      if (!apiBase) {
        // Misconfiguration, not a user error — say so rather than silently
        // pretending the message was sent.
        if (status) {
          status.hidden = false;
          status.dataset.state = 'error';
          status.textContent = text.error;
        }
        return;
      }

      const data = new FormData(form);
      data.set('formName', formName);
      data.set('locale', isKa ? 'ka' : 'en');
      data.set('pageUrl', location.href);

      if (submit) {
        submit.disabled = true;
        submit.textContent = text.sending;
      }
      if (status) status.hidden = true;

      try {
        const response = await fetch(`${apiBase}/api/submit`, {
          method: 'POST',
          body: data,
          credentials: 'include',
        });
        if (!response.ok) throw new Error(`submit failed: ${response.status}`);

        if (status) {
          status.hidden = false;
          status.dataset.state = 'ok';
          status.textContent = text.ok;
        }

        // The conversion. Sent only after the submission is stored, so the
        // numbers in Meta match the leads actually received.
        trackLead(formName, {
          email: String(data.get('email') ?? ''),
          phone: String(data.get('phone') ?? ''),
          firstName: String(data.get('firstName') ?? ''),
          lastName: String(data.get('lastName') ?? ''),
        }, {
          content_category: String(data.get('course') ?? '') || undefined,
        });

        form.reset();
      } catch {
        if (status) {
          status.hidden = false;
          status.dataset.state = 'error';
          status.textContent = text.error;
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      }
    });
  }
</script>
