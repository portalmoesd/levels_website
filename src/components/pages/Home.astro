---
import Base from '../../layouts/Base.astro';
import CourseCard from '../CourseCard.astro';
import QuizCta from '../QuizCta.astro';
import { courses, corporateTracks } from '../../data/courses';
import { artCourses } from '../../data/art';
import { Image } from 'astro:assets';
import { useTranslations, localePath, type Locale } from '../../i18n/utils';
import { image, CAMBRIDGE_CARD } from '../../data/images';
import {
  graph,
  organizationSchema,
  branchSchemas,
  websiteSchema,
  courseListSchema,
} from '../../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const partnerCard = image(CAMBRIDGE_CARD);

/*
 * The four audience blocks. Each renders as a blue panel with its courses as
 * white cards, and each has an anchor so the pills above can jump to it.
 */
const audiences = [
  {
    id: 'children',
    anchor: 'children',
    label: t('group.children'),
    pill: { en: 'Courses for children', ka: 'ბავშვების კურსები' },
    age: { en: 'age: 6–10', ka: 'ასაკი: 6–10' },
    edge: 'var(--accent-red)',
  },
  {
    id: 'teenagers',
    anchor: 'teenagers',
    label: t('group.teenagers'),
    pill: { en: 'Courses for teenagers', ka: 'თინეიჯერების კურსები' },
    age: { en: 'age: 11–17', ka: 'ასაკი: 11–17' },
    edge: 'var(--yellow)',
  },
  {
    id: 'adults',
    anchor: 'adults',
    label: t('group.adults'),
    pill: { en: 'Courses for adults', ka: 'ზრდასრულების კურსები' },
    age: { en: 'age: from 18', ka: 'ასაკი: 18-დან' },
    edge: 'var(--accent-green)',
  },
] as const;

/* Discounts are carried over from the /home variant of the Wix homepage; the
   root homepage did not show them. See docs/content-conflicts.md §2. */
const discounts = [
  {
    id: 'family',
    title: { en: 'Family discount', ka: 'ოჯახური ფასდაკლება' },
    body: {
      en: 'Enroll more than one family member and both of you get a discount.',
      ka: 'დაარეგისტრირე ოჯახის ერთზე მეტი წევრი და ორივემ მიიღეთ ფასდაკლება.',
    },
  },
  {
    id: 'student',
    title: { en: 'Student discount', ka: 'სტუდენტური ფასდაკლება' },
    body: {
      en: 'Are you a student? Get an exclusive discount on our courses.',
      ka: 'სტუდენტი ხარ? მიიღე ექსკლუზიური ფასდაკლება ჩვენს კურსებზე.',
    },
  },
  {
    id: 'friend',
    title: { en: 'Bring a friend', ka: 'მოიყვანე მეგობარი' },
    body: {
      en: 'Invite a friend to join and you both get a discount on enrollment.',
      ka: 'მოიწვიე მეგობარი და ორივემ მიიღეთ ფასდაკლება რეგისტრაციისას.',
    },
  },
] as const;

const title =
  locale === 'ka'
    ? 'ინგლისური ენის კურსები თბილისში'
    : 'English & Art Courses in Tbilisi';

const description =
  locale === 'ka'
    ? 'ინგლისური და ხელოვნების კურსები ბავშვებისთვის, მოზარდებისთვის, ზრდასრულებისა და კომპანიებისთვის. IELTS, კემბრიჯის გამოცდები, საზაფხულო სკოლები. ორი ფილიალი — ვაკე და კრწანისი.'
    : 'English and art courses for children, teenagers, adults and companies in Tbilisi. IELTS and Cambridge exam preparation, summer schools and study abroad. Small groups at our Vake and Krtsanisi branches.';

const jsonLd = graph([
  organizationSchema(locale),
  ...branchSchemas(locale),
  websiteSchema(locale),
  courseListSchema(
    courses.map((course) => ({ course, path: localePath(course.slug, locale) })),
    locale
  ),
]);
---

<Base title={title} description={description} slug="" locale={locale} jsonLd={jsonLd} wide>
  {/* Hero ---------------------------------------------------------- */}
  <section class="hero glow">
    <div class="container hero__inner">
      <div class="hero__left">
        <h1 class="hero__title">
          {locale === 'ka' ? 'თანამედროვე კურსები. რეალური შედეგი.' : 'Modern courses. Real results.'}
        </h1>
        <p class="hero__lede">
          {locale === 'ka'
            ? 'დამწყებიდან თავისუფლად საუბრამდე — ნაბიჯ-ნაბიჯ.'
            : 'From beginner to fluent, step by step.'}
        </p>
        <a class="btn btn--pill" href={localePath('enroll', locale)}>
          {t('cta.enroll')} <span aria-hidden="true">✦</span>
        </a>
      </div>

      {/* The academy's own Cambridge partnership card. */}
      {partnerCard ? (
        <Image
          class="partner-card"
          src={partnerCard}
          alt={locale === 'ka'
            ? 'ლეველს აკადემია — კემბრიჯის ოფიციალური საგანმანათლებლო პარტნიორი'
            : 'Levels Academy — official Cambridge English Educational Partner'}
          widths={[480, 800, 1200]}
          sizes="(max-width: 56rem) 100vw, 52vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <p class="partner-fallback">{t('cambridge.partner')}</p>
      )}
    </div>
  </section>

  {/* Jump links ---------------------------------------------------- */}
  <nav class="container jumps" aria-label={locale === 'ka' ? 'კურსები' : 'Courses'}>
    {audiences.map((audience) => (
      <a class="jump" href={`#${audience.anchor}`}>
        <span class="jump__icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        {audience.pill[locale]}
      </a>
    ))}
    <a class="jump" href="#corporate">
      <span class="jump__icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      {locale === 'ka' ? 'კორპორაციული კურსები' : 'Corporate courses'}
    </a>
  </nav>

  {/* Audience panels ----------------------------------------------- */}
  <div class="container panels">
    {
      audiences.map((audience) => {
        const list = courses.filter((c) => c.audiences.includes(audience.id));
        return (
          <section class="panel" id={audience.anchor} style={`--panel-edge:${audience.edge}`}>
            <header class="panel__head">
              <h2 class="panel__title">{audience.label}</h2>
              <p class="panel__age">{audience.age[locale]}</p>
            </header>
            <div class="panel__cards">
              {list.map((course, i) => (
                <CourseCard course={course} locale={locale} index={i} />
              ))}
            </div>
          </section>
        );
      })
    }

    <section class="panel panel--corporate" id="corporate" style="--panel-edge:var(--navy)">
      <header class="panel__head">
        <h2 class="panel__title">{t('group.corporate')}</h2>
        <p class="panel__age">{t('group.forCompanies')}</p>
      </header>
      <div class="panel__cards">
        {corporateTracks.map((track, i) => (
          <a class="track" href={localePath('corporate-english', locale)} data-i={i % 6}>
            <span class="track__title">{track[locale]}</span>
            <span class="track__meta">{t('course.tailored')}</span>
            <span class="track__price">{t('course.individual')}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  {/* Art ------------------------------------------------------------ */}
  <section class="section container">
    <header class="head">
      <h2>{locale === 'ka' ? 'ხელოვნების კურსები' : 'Art courses'}</h2>
      <a class="head__more" href={localePath('art', locale)}>{t('cta.learnMore')} →</a>
    </header>
    <div class="grid grid--4 art-grid">
      {artCourses.slice(0, 4).map((course, i) => (
        <CourseCard
          course={course}
          locale={locale}
          index={i + 2}
          href={course.slug === 'contemporary-art' ? localePath('art', locale) : undefined}
        />
      ))}
    </div>
  </section>

  {/* Discounts ------------------------------------------------------ */}
  <section class="section">
    <div class="container">
      <header class="head">
        <h2>{locale === 'ka' ? 'ფასდაკლებები' : 'Discounts'}</h2>
      </header>
      <ul class="grid grid--3 discounts">
        {discounts.map((discount) => (
          <li class="discount">
            <p class="discount__value">−10%</p>
            <h3 class="discount__title">{discount.title[locale]}</h3>
            <p class="muted">{discount.body[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <QuizCta locale={locale} />
</Base>

<style>
  /* Hero ------------------------------------------------------------ */
  .hero { padding-block: clamp(2rem, 1.5rem + 3vw, 4rem); }
  .hero__inner {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
  }
  .hero__left { align-self: center; }
  .hero__title { max-width: 14ch; }
  .hero__lede {
    font-size: var(--step-1);
    color: var(--ink-muted);
    margin-block: 0.9rem 1.6rem;
    max-width: 32ch;
  }

  .partner-card {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow);
  }
  .partner-fallback {
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #ffdd8e 0%, var(--yellow) 45%, #f9b73d 100%);
    font-family: var(--font-display);
    font-weight: 700;
    text-align: center;
    color: var(--navy);
  }

  /* Jump links ------------------------------------------------------ */
  .jumps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.75rem;
    margin-block: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  .jump {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    background: var(--surface);
  }
  .jump:hover { border-color: var(--navy); color: var(--navy); }
  .jump__icon {
    display: grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    flex-shrink: 0;
  }

  /* Audience panels ------------------------------------------------- */
  .panels { display: grid; gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem); }

  .panel {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    padding: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    border-radius: var(--radius-lg);
    /* The panel fades from the brand blue into a per-audience accent. */
    background: linear-gradient(100deg, var(--blue) 0%, var(--blue) 55%, var(--panel-edge) 190%);
  }
  .panel--corporate {
    background: linear-gradient(100deg, var(--blue) 0%, var(--blue) 55%, var(--navy) 150%);
  }

  .panel__head {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1rem 0.5rem;
  }
  .panel__title {
    font-size: var(--step-1);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .panel__age {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    color: var(--navy);
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-weight: 700;
    white-space: nowrap;
  }

  .panel__cards {
    display: grid;
    gap: clamp(0.6rem, 0.4rem + 0.8vw, 1rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr));
  }

  /* Corporate tracks reuse the card shape without price or schedule. */
  .track {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.1rem 1.15rem 1rem;
    background: var(--surface);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .track:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .track__title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--navy);
  }
  .track__meta { font-size: var(--step--2); color: var(--ink-muted); flex-grow: 1; }
  .track__price {
    align-self: flex-end;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--navy);
  }

  /* Sections -------------------------------------------------------- */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-block-end: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }
  .head__more {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--blue);
    text-decoration: none;
  }

  /* Art cards sit on white, so they need a border the panel cards do not. */
  .art-grid :global(.course-card) { border: 1.5px solid var(--line); }

  .discounts { list-style: none; padding: 0; margin: 0; }
  .discount {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: var(--yellow-pale);
  }
  .discount__value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    color: var(--navy);
    line-height: 1;
  }
  .discount__title { font-size: var(--step-1); margin-block: 0.5rem 0.35rem; }

  @media (max-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .panel { grid-template-columns: 1fr; }
    .panel__head {
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
      gap: 0.85rem;
      padding: 0.35rem 0.35rem 0.5rem;
    }
  }
</style>
