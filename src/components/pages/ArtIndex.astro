---
import Base from '../../layouts/Base.astro';
import CourseCard from '../CourseCard.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { artCourses, artHighlights, artPartners } from '../../data/art';
import { imageSet } from '../../data/images';
import { useTranslations, localePath, type Locale } from '../../i18n/utils';
import { graph, organizationSchema, courseListSchema, breadcrumbSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Student work carried over from the current Art Academy page.
const gallery = imageSet('art-');

const title = locale === 'ka' ? 'ხელოვნების აკადემია' : 'Art Academy';
const description =
  locale === 'ka'
    ? 'ხატვისა და ფერწერის კურსები თბილისში 5 წლიდან: მოქმედი ხელოვანები, ინტერაქტიული გაკვეთილები, ყოველწლიური გამოფენა და ოფიციალური სერტიფიკატი. პორტფოლიოს მომზადება საზღვარგარეთ სასწავლებლად.'
    : 'Drawing and painting courses in Tbilisi from age 5: taught by practising artists, with interactive lessons, an annual exhibition and an official certificate. Portfolio preparation for studying art abroad.';

const trail = [
  { name: locale === 'ka' ? 'მთავარი' : 'Home', path: localePath('', locale) },
  { name: title, path: localePath('art', locale) },
];

const jsonLd = graph([
  organizationSchema(locale),
  courseListSchema(
    artCourses
      .filter((c) => c.slug !== 'contemporary-art')
      .map((course) => ({ course, path: localePath(course.slug, locale) })),
    locale
  ),
  breadcrumbSchema(trail),
]);
---

<Base title={title} description={description} slug="art" locale={locale} jsonLd={jsonLd}>
  <Breadcrumbs trail={trail} locale={locale} />

  <header class="art-hero glow">
    <div class="container">
      <p class="eyebrow">Levels Art Academy</p>
      <h1>{title}</h1>
      <p class="art-hero__lede">
        {locale === 'ka'
          ? 'ხატვა და ფერწერა მოქმედ ხელოვანებთან ერთად — კომპოზიციიდან და პერსპექტივიდან საკუთარ სტილამდე, დასკვნითი გამოფენითა და სერტიფიკატით.'
          : 'Drawing and painting with practising artists — from composition and perspective through to a style of your own, ending in an exhibition and a certificate.'}
      </p>
    </div>
  </header>

  <section class="section container">
    <h2 class="visually-hidden">{locale === 'ka' ? 'კურსები' : 'Courses'}</h2>
    <div class="grid grid--3">
      {artCourses.map((course) => (
        <CourseCard
          course={course}
          locale={locale}
          href={course.slug === 'contemporary-art' ? null : undefined}
        />
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title">{locale === 'ka' ? 'რატომ Levels Art' : 'Why Levels Art'}</h2>
      <ul class="grid grid--4 highlights">
        {artHighlights.map((highlight) => (
          <li class="card">
            <h3>{highlight.title[locale]}</h3>
            <p class="muted">{highlight.body[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="section container">
      <h2 class="section-title">{locale === 'ka' ? 'მოსწავლეთა ნამუშევრები' : 'Student work'}</h2>
      <ul class="gallery">
        {gallery.map((art) => (
          <li>
            <Image
              src={art}
              alt={locale === 'ka' ? 'მოსწავლის ნამუშევარი' : 'Student artwork'}
              widths={[240, 420]}
              sizes="(max-width: 52rem) 45vw, 22vw"
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section container">
    <div class="partners card">
      <h2>{locale === 'ka' ? 'პარტნიორი უნივერსიტეტები' : 'Partner universities'}</h2>
      <p class="muted">
        {locale === 'ka'
          ? 'პორტფოლიოს კურსის მონაწილეები უფასო მხარდაჭერას იღებენ ამ უნივერსიტეტებში ჩაბარებისას:'
          : 'Students on the portfolio course get free admission support for applications to:'}
      </p>
      <ul>
        {artPartners.map((partner) => <li>{partner}</li>)}
      </ul>
      <a class="btn btn--secondary" href={localePath('portfolio-creation', locale)}>
        {t('cta.learnMore')}
      </a>
    </div>
  </section>
</Base>

<style>
  .art-hero {
    background: transparent;
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem);
  }
  .art-hero h1 { margin-block: 0.5rem 1rem; }
  .art-hero .eyebrow { color: var(--blue); }
  .art-hero__lede { color: var(--ink-muted); font-size: var(--step-1); max-width: 60ch; }

  .section-title { margin-block-end: clamp(1.25rem, 1rem + 1vw, 2rem); }
  .highlights { list-style: none; padding: 0; margin: 0; }
  .highlights h3 { font-size: var(--step-1); margin-block-end: 0.5rem; }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: clamp(0.6rem, 0.4rem + 0.8vw, 1rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .partners ul {
    margin-block: 1rem 1.5rem;
    padding-inline-start: 1.25rem;
  }
  .partners li + li { margin-block-start: 0.35rem; }
</style>
