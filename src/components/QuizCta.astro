---
import { useTranslations, localePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="quiz-cta">
  <div class="container quiz-cta__inner">
    <div>
      <h2>{t('quiz.title')}</h2>
      <p>{t('quiz.body')}</p>
    </div>
    <a class="btn btn--primary" href={localePath('placement-quiz', locale)}>
      {t('cta.takeQuiz')}
    </a>
  </div>
</section>

<style>
  .quiz-cta {
    background: var(--navy);
    color: #fff;
    padding-block: var(--section-y);
  }
  .quiz-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .quiz-cta h2 { color: #fff; }
  .quiz-cta p { color: #cfdded; max-width: 52ch; margin-block-start: 0.5rem; }
</style>
