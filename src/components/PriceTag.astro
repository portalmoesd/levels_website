---
import type { Price } from '../data/types';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  price: Price;
  locale: Locale;
  /** 'card' right-aligns and stacks; 'stacked' centres, for the fact row. */
  layout?: 'card' | 'stacked';
}

const { price, locale, layout = 'card' } = Astro.props;
const t = useTranslations(locale);

const SYMBOL: Record<NonNullable<Price['currency']>, string> = {
  GEL: '₾',
  USD: '$',
  GBP: '£',
};
const symbol = SYMBOL[price.currency ?? 'GEL'];

// Thousands are grouped with a comma throughout the site ("₾1,680", "$5,300").
const format = (value: number) => `${symbol}${value.toLocaleString('en-US')}`;

const unitLabel =
  price.unit === 'month'
    ? t('course.perMonth')
    : price.unit === 'course'
      ? t('course.perCourse')
      : '';
---

{
  price.unit === 'individual' || price.now === undefined ? (
    <p class:list={['price', `price--${layout}`]}>
      <span class="price__individual">{t('course.individual')}</span>
    </p>
  ) : (
    <p class:list={['price', `price--${layout}`]}>
      {price.was !== undefined && (
        <span class="price__was">
          <span class="visually-hidden">{locale === 'ka' ? 'ძველი ფასი' : 'Was'}</span>
          {format(price.was)}
        </span>
      )}
      <span class="price__now">{format(price.now)}{unitLabel}</span>
    </p>
  )
}

<style>
  .price--stacked {
    align-items: center;
    text-align: center;
  }

  .price__individual {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--navy);
  }
</style>
