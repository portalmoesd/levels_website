---
import PriceTag from './PriceTag.astro';
import type { Course } from '../data/types';
import { useTranslations, localePath, type Locale } from '../i18n/utils';

interface Props {
  course: Course;
  locale: Locale;
  /** null renders the card without a link (courses with no page of their own). */
  href?: string | null;
  /** Position in the row, which picks the accent colour for the badge. */
  index?: number;
}

const { course, locale, href, index = 0 } = Astro.props;
const t = useTranslations(locale);

const link = href === null ? null : (href ?? localePath(course.slug, locale));
const Tag = link ? 'a' : 'div';

/* Each card in a row carries a different accent, which is what gives the
   course grid its colour. Cycled by position so any row length works. */
const ACCENTS = ['mint', 'red', 'yellow', 'blue', 'lilac', 'green'] as const;
const accent = ACCENTS[index % ACCENTS.length];
---

<Tag
  class:list={['course-card', link && 'course-card--link']}
  href={link ?? undefined}
  data-accent={accent}
>
  <div class="course-card__head">
    <h3 class="course-card__title">{course.title[locale]}</h3>
    <span class="course-card__badge" aria-hidden="true"></span>
  </div>

  <dl class="course-card__meta">
    <div>
      <dt class="visually-hidden">{t('course.lessonLength')}</dt>
      <dd>
        <span class="course-card__icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="8" cy="8" r="6" />
            <path d="M8 5v3.2l2 1.4" stroke-linecap="round" />
          </svg>
        </span>
        {course.lessonLength[locale]}
      </dd>
    </div>
    <div>
      <dt class="visually-hidden">{t('course.perWeek')}</dt>
      <dd>
        <span class="course-card__icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="2.2" y="3.2" width="11.6" height="10.6" rx="2" />
            <path d="M2.2 6.6h11.6M5.6 2v2.4M10.4 2v2.4" stroke-linecap="round" />
          </svg>
        </span>
        {course.perWeek[locale]}
      </dd>
    </div>
  </dl>

  <PriceTag price={course.price} locale={locale} />
</Tag>

<style>
  .course-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    min-height: 11.5rem;
    padding: 1.1rem 1.15rem 1rem;
    background: var(--surface);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .course-card--link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .course-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .course-card__title {
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--navy);
  }

  /* The small coloured dot beside each course name. */
  .course-card__badge {
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: var(--card-accent, var(--accent-mint));
  }
  .course-card[data-accent='mint']   { --card-accent: var(--accent-mint); }
  .course-card[data-accent='red']    { --card-accent: var(--accent-red); }
  .course-card[data-accent='yellow'] { --card-accent: var(--yellow); }
  .course-card[data-accent='blue']   { --card-accent: var(--blue-light); }
  .course-card[data-accent='lilac']  { --card-accent: var(--accent-lilac); }
  .course-card[data-accent='green']  { --card-accent: var(--accent-green); }

  .course-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin: 0;
    flex-grow: 1;
    align-content: start;
  }
  .course-card__meta div { margin: 0; }
  .course-card__meta dd {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    font-size: var(--step--2);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .course-card__icon {
    display: inline-flex;
    color: var(--blue-light);
  }
</style>
