---
import PriceTag from './PriceTag.astro';
import type { Course } from '../data/types';
import { useTranslations, localePath, type Locale } from '../i18n/utils';

interface Props {
  course: Course;
  locale: Locale;
  /** Set when the course has no page of its own (e.g. Contemporary Art). */
  href?: string | null;
}

const { course, locale, href } = Astro.props;
const t = useTranslations(locale);
const link = href === null ? null : (href ?? localePath(course.slug, locale));
const Tag = link ? 'a' : 'div';
---

<Tag class:list={['course-card', link && 'course-card--link']} href={link ?? undefined}>
  <p class="eyebrow">{course.ageLabel[locale]}</p>
  <h3 class="course-card__title">{course.title[locale]}</h3>

  <dl class="course-card__meta">
    <div>
      <dt>{t('course.lessonLength')}</dt>
      <dd>{course.lessonLength[locale]}</dd>
    </div>
    <div>
      <dt>{t('course.perWeek')}</dt>
      <dd>{course.perWeek[locale]}</dd>
    </div>
  </dl>

  <PriceTag price={course.price} locale={locale} />
</Tag>

<style>
  .course-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    height: 100%;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .course-card--link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--navy-300);
  }

  .course-card__title {
    font-size: var(--step-1);
    margin-block-end: 0.2rem;
  }

  .course-card__meta {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    flex-grow: 1;
  }
  .course-card__meta div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-block-end: 1px dashed var(--line);
    padding-block-end: 0.35rem;
  }
  .course-card__meta dt { font-weight: 500; }
  .course-card__meta dd { margin: 0; text-align: end; color: var(--ink); }
</style>
